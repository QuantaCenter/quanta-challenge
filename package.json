{
   "name": "quanta-challenge",
   "module": "index.ts",
   "type": "module",
   "scripts": {
      "docker:build": "docker-compose -f docker/docker-compose.yaml build",
      "docker:build:proxy": "docker-compose -f docker/docker-compose.development.yaml build --build-arg http_proxy=http://host.docker.internal:7890 --build-arg https_proxy=http://host.docker.internal:7890",
      "docker:up": "docker-compose -f docker/docker-compose.yaml up -d",
      "docker:down": "docker-compose -f docker/docker-compose.yaml down",
      "docker:up:dev": "docker-compose -f docker/docker-compose.development.yaml up -d",
      "docker:down:dev": "docker-compose -f docker/docker-compose.development.yaml down",
      "typecheck": "pnpm -r --no-bail typecheck",
      "smoke": "pnpm --filter @challenge/app smoke",
      "qpc": "pnpm --filter @challenge/problem-creator-cli dev"
   },
   "peerDependencies": {
      "typescript": "^5.0.0"
   },
   "workspaces": [
      "packages/*"
   ],
   "pnpm": {
      "onlyBuiltDependencies": [
         "@prisma/client",
         "prisma",
         "sharp",
         "esbuild"
      ]
   }
}
