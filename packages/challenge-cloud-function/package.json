{
   "name": "@challenge/cloud-function",
   "type": "module",
   "scripts": {
      "dev": "vite",
      "build": "vite build",
      "start": "node dist/index.js",
      "typecheck": "tsc --noEmit",
      "test": "vitest run",
      "e2e": "tsx scripts/e2e.ts",
      "docker:build": "docker build -t challenge-cloud-function -f ./Dockerfile ../..",
      "docker:build:proxy": "docker build -t challenge-cloud-function -f ./Dockerfile ../.. --build-arg http_proxy=http://host.docker.internal:7890 --build-arg https_proxy=http://host.docker.internal:7890"
   },
   "dependencies": {
      "@challenge/database": "workspace:^",
      "@challenge/shared": "workspace:^",
      "@hono/node-server": "^1.18.1",
      "@prisma/client": "^6.12.0",
      "dotenv": "^17.2.1",
      "esbuild": "^0.25.5",
      "hono": "^4.8.12",
      "ioredis": "^5.6.1",
      "pino": "^10.3.1",
      "pino-pretty": "^13.1.3",
      "zod": "^4.0.5"
   },
   "devDependencies": {
      "@hono/vite-dev-server": "^0.24.0",
      "@types/node": "^24.0.14",
      "tsx": "^4.7.1",
      "typescript": "^5.8.3",
      "vite": "^7.3.0",
      "vitest": "^3.2.4"
   }
}
