generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id           String    @id @default(cuid())
  role         UserRole  @default(USER)
  name         String    @unique
  email        String?   @unique
  displayName  String?
  imageId      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLogin    DateTime  @default(now())
  /// 最近一次「有活动」的时间：登录之外的浏览、提交、做题等都会刷新它。
  /// 由 tRPC 中间件 server/trpc/middlewares/track-active.ts 写入（按用户节流）。
  /// 允许为空：迁移前的历史用户没有值。
  lastActiveAt DateTime?
  score        Int       @default(0)

  avatar                    Image?                      @relation(fields: [imageId], references: [id])
  auths                     Auth[]
  WebAuthnCredential        WebAuthnCredential[]
  StatusTransitions         StatusTransitions[]
  Tag                       Tags[]
  FileSystem                FileSystems[]
  VirtualFile               VirtualFiles[]
  Project                   Projects[]
  RoleTransition            RoleTransition[]
  UserImage                 UserImage[]
  JudgeRecord               JudgeRecords[]
  BaseProblems              BaseProblems[]
  ProblemVersionTransitions ProblemVersionTransitions[]
  DailyCheckin              DailyCheckin[]
  UserAchievement           UserAchievement[]
  Achievement               Achievement[]
  UserStatistic             UserStatistic?
  RankingHistory            RankingHistory[]
  UserSettings              UserSetting?
  UserInfo                  UserInfo?
  UserSpaceConfig           UserSpaceConfig?
  notifications             Notification[]
  Course                    Course[]
  CourseReviewRecord        CourseReviewRecord[]
  Topic                     Topic[]
  Article                   Article[]
  LearningVisit             LearningVisit[]
  LearningCompletion        LearningCompletion[]

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
}

// 用户信息表
model UserInfo {
  id            Int       @id @default(autoincrement())
  userId        String    @unique
  bio           String?
  email         String?
  major         String?
  identifier    String?
  birthday      DateTime?
  bannerImageId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User   @relation(fields: [userId], references: [id])
  bannerImage Image? @relation(fields: [bannerImageId], references: [id])

  @@map("user_infos")
}

// 角色变更记录表
model RoleTransition {
  id             Int          @id @default(autoincrement())
  userId         String
  fromRole       UserRole
  toRole         UserRole
  changeByType   ChangeByType
  changeByUserId String?
  createdAt      DateTime     @default(now())

  user User @relation(fields: [userId], references: [id])

  @@map("role_transitions")
}

// 认证提供商枚举
enum AuthProvider {
  QQ
  EMAIL
}

// 认证表
model Auth {
  id           String       @id @default(cuid())
  userId       String
  provider     AuthProvider
  providerId   String
  accessToken  String?
  refreshToken String?
  email        String?
  password     String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@map("auths")
}

// WebAuthn 凭证表
model WebAuthnCredential {
  id        String   @id @default(cuid())
  userId    String
  publicKey String
  counter   Int      @default(0)
  lastUsed  DateTime @default(now())
  transport String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, publicKey])
  @@map("webauthn_credentials")
}

// 图片表
model Image {
  id        String   @id @default(cuid())
  name      String
  thumbhash String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refCount  Int      @default(0)

  User                User[]
  Tag                 Tags[]
  ShadowFile          ShadowFile[]
  ProblemDefaultCover ProblemDefaultCovers[]
  UserImage           UserImage[]
  Problem             Problems[]
  Achievement         Achievement[]
  UserInfo            UserInfo[]

  @@map("images")
}

model UserImage {
  id        String   @id @default(cuid())
  userId    String
  imageId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id])
  image Image @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@unique([userId, imageId])
  @@map("user_images")
}

// 问题表
model BaseProblems {
  id         Int      @id @default(autoincrement())
  authorId   String
  currentPid Int?     @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  Author                    User                        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  CurrentProblem            Problems?                   @relation("CurrentProblem", fields: [currentPid], references: [pid], onDelete: SetNull)
  ProblemVersions           Problems[]                  @relation("ProblemVersions")
  ProblemVersionTransitions ProblemVersionTransitions[]
  DailyProblem              DailyProblem[]
  /// 引用这道题的文章（由文章正文里的 <Problem baseId={…} /> 解析而来）
  ArticleProblem            ArticleProblem[]

  @@map("base_problems")
}

// 问题版本表
model Problems {
  pid             Int        @id @default(autoincrement())
  baseId          Int
  title           String
  detail          String
  isDeprecated    Boolean    @default(false)
  difficulty      Difficulty
  totalScore      Int
  status          Status
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  coverImageId    String?
  bootCommand     String?
  initCommand     String?
  buildCommand    String?
  judgeUploadPath String
  enableCloudFunction Boolean @default(false)
  tags            Tags[]

  AuditRecord                 AuditRecords[]
  StatusTransitions           StatusTransitions[]
  JudgeFile                   JudgeFiles[]
  Project                     Projects[]
  ProblemDefaultCover         ProblemDefaultCovers[]
  JudgeRecord                 JudgeRecords[]
  TemplateJudgeRecord         TemplateJudgeRecords[]
  CoverImage                  Image?                      @relation(fields: [coverImageId], references: [id])
  BaseProblem                 BaseProblems                @relation("ProblemVersions", fields: [baseId], references: [id], onDelete: Cascade)
  CurrentOfBase               BaseProblems?               @relation("CurrentProblem")
  ProblemVersionTransitions   ProblemVersionTransitions[] @relation("FromProblemVersions")
  ProblemVersionTransitionsTo ProblemVersionTransitions[] @relation("ToProblemVersions")
  JudgeStatus                 JudgeStatus?

  @@map("problems")
}

// 问题版本变更记录表
model ProblemVersionTransitions {
  id             Int          @id @default(autoincrement())
  baseProblemId  Int
  fromId         Int
  toId           Int
  changeByUserId String?
  changeByType   ChangeByType
  createdAt      DateTime     @default(now())

  base BaseProblems @relation(fields: [baseProblemId], references: [id], onDelete: Cascade)
  from Problems     @relation("FromProblemVersions", fields: [fromId], references: [pid], onDelete: Cascade)
  to   Problems     @relation("ToProblemVersions", fields: [toId], references: [pid], onDelete: Cascade)
  user User?        @relation(fields: [changeByUserId], references: [id])

  @@map("problem_version_transitions")
}

model ProblemDefaultCovers {
  id        Int      @id @default(autoincrement())
  problemId Int
  imageId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problem Problems @relation(fields: [problemId], references: [pid], onDelete: Cascade)
  image   Image    @relation(fields: [imageId], references: [id])

  @@map("problem_default_covers")
}

enum Difficulty {
  easy
  medium
  hard
  very_hard
}

enum Status {
  draft
  invalid
  ready
  published
}

// 审核记录表
model AuditRecords {
  rid       Int      @id @default(autoincrement())
  problemId Int
  result    Result
  reason    String?
  score     Int      @default(0)
  timeCost  Int      @default(0)
  createdAt DateTime @default(now())

  problem Problems @relation(fields: [problemId], references: [pid], onDelete: Cascade)

  @@map("audit_records")
}

enum Result {
  failed
  passed
}

// 状态变更记录表
model StatusTransitions {
  id             Int          @id @default(autoincrement())
  problemId      Int
  fromStatus     Status
  toStatus       Status
  changeByType   ChangeByType
  changeByUserId String?
  createdAt      DateTime     @default(now())

  problem Problems @relation(fields: [problemId], references: [pid], onDelete: Cascade)
  user    User?    @relation(fields: [changeByUserId], references: [id])

  @@map("status_transitions")
}

enum ChangeByType {
  user
  system
}

model TemplateJudgeRecords {
  id            Int      @id @default(autoincrement())
  judgeRecordId Int
  problemId     Int
  createdAt     DateTime @default(now())

  problem     Problems     @relation(fields: [problemId], references: [pid], onDelete: Cascade)
  judgeRecord JudgeRecords @relation(fields: [judgeRecordId], references: [id], onDelete: Cascade)

  @@map("template_judge_records")
}

// 判题状态表
model JudgeStatus {
  id          Int      @id @default(autoincrement())
  problemId   Int      @unique
  passedCount Int      @default(0)
  totalCount  Int      @default(0)
  updatedAt   DateTime @updatedAt

  problem Problems @relation(fields: [problemId], references: [pid], onDelete: Cascade)

  @@map("judge_status")
}

model JudgeRecords {
  id          Int         @id @default(autoincrement())
  problemId   Int
  userId      String
  info        Json
  result      JudgeResult @default(pending)
  type        JudgeType
  score       Int         @default(0)
  pendingTime Int         @default(0)
  judgingTime Int         @default(0)
  createdAt   DateTime    @default(now())

  problem             Problems               @relation(fields: [problemId], references: [pid], onDelete: Cascade)
  user                User                   @relation(fields: [userId], references: [id])
  ShadowFile          ShadowFile[]
  TemplateJudgeRecord TemplateJudgeRecords[]

  @@map("judge_records")
}

enum JudgeResult {
  pending
  success
  failed
}

enum JudgeType {
  audit
  judge
}

// 判题文件表
model JudgeFiles {
  id          Int    @id @default(autoincrement())
  judgeScript String
  problemId   Int

  problem Problems @relation(fields: [problemId], references: [pid], onDelete: Cascade)

  @@map("judge_files")
}

// 标签表
model Tags {
  tid         Int      @id @default(autoincrement())
  name        String
  description String?
  creatorId   String
  imageId     String?
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator User       @relation(fields: [creatorId], references: [id])
  image   Image?     @relation(fields: [imageId], references: [id])
  Problem Problems[]

  @@map("tags")
}

// 文件系统表
model FileSystems {
  fsid      String         @id @default(uuid())
  ownerId   String
  projectId String?
  files     VirtualFiles[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  owner   User      @relation(fields: [ownerId], references: [id])
  project Projects? @relation(fields: [projectId], references: [pid])

  @@map("file_systems")
}

// 项目表
model Projects {
  pid        String   @id @default(uuid())
  // 是否为作答模板
  isTemplate Boolean  @default(false)
  name       String
  ownerId    String
  problemId  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner      User          @relation(fields: [ownerId], references: [id])
  problem    Problems      @relation(fields: [problemId], references: [pid], onDelete: Cascade)
  FileSystem FileSystems[]

  @@index([ownerId, problemId])
  @@map("projects")
}

// 虚拟文件表
model VirtualFiles {
  vid       String   @id @default(uuid())
  path      String
  content   String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User         @relation(fields: [ownerId], references: [id])
  FileSystem     FileSystems? @relation(fields: [fileSystemFsid], references: [fsid], onDelete: Cascade)
  fileSystemFsid String?

  @@index([ownerId])
  @@map("virtual_files")
}

// 影子文件表，判题产生的文件
model ShadowFile {
  sfid          String         @id @default(uuid())
  type          ShadowFileType
  judgeRecordId Int
  imageId       String?
  text          String?
  jsonb         Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  judgeRecord JudgeRecords @relation(fields: [judgeRecordId], references: [id], onDelete: Cascade)
  image       Image?       @relation(fields: [imageId], references: [id])

  @@map("shadow_files")
}

enum ShadowFileType {
  image
  text
}

model DailyProblem {
  id            Int      @id @default(autoincrement())
  date          DateTime @unique
  baseProblemId Int
  createdAt     DateTime @default(now())

  baseProblem BaseProblems @relation(fields: [baseProblemId], references: [id], onDelete: Cascade)

  @@map("daily_problems")
}

model DailyCheckin {
  id        Int      @id @default(autoincrement())
  userId    String
  date      DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("daily_checkins")
}

model Achievement {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  description  String?
  badgeImageId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  authorId     String?
  score        Int      @default(50)

  author                         User?                       @relation(fields: [authorId], references: [id])
  badgeImage                     Image                       @relation(fields: [badgeImageId], references: [id])
  UserAchievement                UserAchievement[]
  AchievementDependencyData      AchievementDependencyData[]
  AchievementValidateScript      AchievementValidateScript?
  CheckinAchievement             CheckinAchievement?
  AchievementPreAchievement      AchievementPreAchievement[] @relation("AchievementWithPre")
  AchievementPreAchievementAsPre AchievementPreAchievement[] @relation("AchievementAsPre")

  @@map("achievements")
}

model AchievementPreAchievement {
  id               Int      @id @default(autoincrement())
  achievementId    Int
  preAchievementId Int
  createdAt        DateTime @default(now())

  achievement    Achievement @relation("AchievementWithPre", fields: [achievementId], references: [id], onDelete: Cascade)
  preAchievement Achievement @relation("AchievementAsPre", fields: [preAchievementId], references: [id], onDelete: Cascade)

  @@unique([achievementId, preAchievementId])
  @@map("achievement_pre_achievements")
}

model CheckinAchievement {
  id            Int      @id @default(autoincrement())
  achievementId Int      @unique
  createdAt     DateTime @default(now())

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@map("checkin_achievements")
}

model AchievementDependencyDataRequestRecord {
  id        Int      @id @default(autoincrement())
  userId    String
  success   Boolean  @default(false)
  reason    String?
  sql       String
  name      String
  createdAt DateTime @default(now())

  @@map("achievement_dependency_data_request_records")
}

model AchievementDependencyData {
  id                         Int      @id @default(autoincrement())
  achievementId              Int
  achievementDepDataLoaderId Int
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  achievementDepDataLoader AchievementDepDataLoader @relation(fields: [achievementDepDataLoaderId], references: [id], onDelete: Cascade)
  achievement              Achievement              @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([achievementId, achievementDepDataLoaderId])
  @@map("achievement_dependency_data")
}

model AchievementValidateScript {
  id            Int      @id @default(autoincrement())
  achievementId Int      @unique
  script        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@map("achievement_validate_scripts")
}

enum AchievementDepDataType {
  NUMERIC
  BOOLEAN
  TEXT
}

model AchievementDepDataLoader {
  id          Int                    @id @default(autoincrement())
  name        String
  description String?
  sql         String
  type        AchievementDepDataType
  isList      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  AchievementDependencyData AchievementDependencyData[]

  @@map("achievement_dep_data_loaders")
}

model UserAchievement {
  id            Int      @id @default(autoincrement())
  progress      Float    @default(0)
  userId        String
  achievementId Int
  achievedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model UserStatistic {
  id          Int      @id @default(autoincrement())
  userId      String   @unique
  score       Int      @default(0)
  correctRate Float    @default(0)
  passCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_statistics")
}

model RankingHistory {
  id        Int      @id @default(autoincrement())
  userId    String
  score     Int
  rank      Int
  date      DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ranking_histories")
}

model UserSetting {
  id        Int      @id @default(autoincrement())
  userId    String   @unique
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@map("user_settings")
}

// 用户空间展示配置表
model UserSpaceConfig {
  id                     Int      @id @default(autoincrement())
  userId                 String   @unique
  // 提交情况模块可见性
  showSubmissionStatus   Boolean  @default(true)
  // 成就模块可见性
  showAchievements       Boolean  @default(true)
  // 个人信息字段可见性配置（JSON: { birthday: boolean, email: boolean, identifier: boolean, major: boolean }）
  personalInfoVisibility Json     @default("{\"birthday\":true,\"email\":true,\"identifier\":true,\"major\":true}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_space_configs")
}

enum NotificationType {
  SYSTEM
  COMMENT
  LIKE
  JUDGE
  ACHIEVEMENT
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  content   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model CloudFunction {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String   @default("")
  enabled          Boolean  @default(true)
  kvUserIsolated   Boolean  @default(true)
  timeoutMs        Int      @default(5000)
  maxResponseBytes Int      @default(262144)
  activeVersionId  String?  @unique
  createdBy        String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  activeVersion CloudFunctionVersion?  @relation("activeVersion", fields: [activeVersionId], references: [id])
  versions      CloudFunctionVersion[] @relation("versions")
  apiKeys       CloudFunctionApiKey[]

  @@map("cloud_functions")
}

model CloudFunctionVersion {
  id           String   @id @default(cuid())
  functionId   String
  version      Int
  source       String
  compiledCode String
  sourceHash   String
  createdBy    String
  createdAt    DateTime @default(now())

  function  CloudFunction  @relation("versions", fields: [functionId], references: [id], onDelete: Cascade)
  activeFor CloudFunction? @relation("activeVersion")

  @@unique([functionId, version])
  @@map("cloud_function_versions")
}

model CloudFunctionApiKey {
  id               String    @id @default(cuid())
  keyId            String    @unique
  name             String
  scopes           String[]
  enabled          Boolean   @default(true)
  allowedFunctions String[]  @default([])
  masterVersion    Int       @default(1)
  createdBy        String
  lastUsedAt       DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  cloudFunctionId  String?

  cloudFunction CloudFunction? @relation(fields: [cloudFunctionId], references: [id])

  @@map("cloud_function_api_keys")
}

/// 调用记录（审计 + 排障），由清理任务按保留期删除。
model CloudFunctionInvocation {
  id          String   @id @default(cuid())
  functionId  String
  versionId   String
  callerType  String
  callerKeyId String?
  userId      String?
  status      String
  errorCode   String?
  durationMs  Int
  inputBytes  Int      @default(0)
  outputBytes Int      @default(0)
  traceId     String?
  createdAt   DateTime @default(now())

  @@index([functionId, createdAt])
  @@index([userId, createdAt])
  @@map("cloud_function_invocations")
}

// ============================================================
// 学习内容：课程 / 专题 / 文章（设计文档 §6、§17）
//
// 三个约定（§17.2）：
//   1. 只有一处「归属」：专题属于课程；文章独立存在，被专题**引用**；
//   2. 引用带顺序（TopicArticle.sort / ArticleProblem.sort），
//      因为「专题页里的文章顺序」是编排结果，不是时间顺序；
//   3. 有引用的对象不可删除（关系上用 Restrict），而不是静默级联。
// ============================================================

/// 课程：学习侧的入口与骨架，也是**唯一需要审核**的实体（§17.1）
model Course {
  id          String       @id @default(cuid())
  authorId    String
  slug        String       @unique
  name        String
  description String       @default("")
  /// 学习侧按它排序（同一批里小的在前）
  weight      Int          @default(10)
  status      CourseStatus @default(DRAFT)
  coverPreset String       @default("slate")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  /// 最近一次审核动作的时间，卡片/列表按它倒序时用
  reviewedAt  DateTime?

  Author        User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  Topics        Topic[]
  ReviewRecords CourseReviewRecord[]

  @@index([status, weight])
  @@map("courses")
}

/// 课程审核留痕：提交 / 通过 / 驳回各一条（§17.3）
model CourseReviewRecord {
  id         String             @id @default(cuid())
  courseId   String
  actorId    String
  action     CourseReviewAction
  /// 驳回理由；通过/提交时可为空
  reason     String?
  /// 动作后的课程状态，便于直接读历史而不必反推
  toStatus   CourseStatus
  createdAt  DateTime           @default(now())

  Course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  Actor  User   @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([courseId, createdAt])
  @@map("course_review_records")
}

/// 专题：属于某个课程，**不需要审核**（可见性跟随课程，§17.1）
model Topic {
  id          String   @id @default(cuid())
  authorId    String
  /// 归属：非空。删除课程时 Restrict，必须先安置专题（§17.2）
  courseId    String
  slug        String
  name        String
  description String   @default("")
  weight      Int      @default(10)
  coverPreset String   @default("slate")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Author        User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  Course        Course              @relation(fields: [courseId], references: [id], onDelete: Restrict)
  Articles      TopicArticle[]
  Prerequisites TopicPrerequisite[] @relation("TopicPrerequisites")
  RequiredBy    TopicPrerequisite[] @relation("TopicRequiredBy")

  @@unique([courseId, slug])
  @@index([courseId, weight])
  @@map("topics")
}

/// 专题 → 文章：带顺序的引用
model TopicArticle {
  id        String @id @default(cuid())
  topicId   String
  articleId String
  /// 专题页里的展示顺序
  sort      Int    @default(0)

  Topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  Article Article @relation(fields: [articleId], references: [id], onDelete: Restrict)

  @@unique([topicId, articleId])
  @@index([topicId, sort])
  @@index([articleId])
  @@map("topic_articles")
}

/// 专题 → 前置专题（只用于排序与展示，不做访问控制，§9.1）
model TopicPrerequisite {
  id            String @id @default(cuid())
  topicId       String
  prerequisiteId String

  Topic        Topic @relation("TopicPrerequisites", fields: [topicId], references: [id], onDelete: Cascade)
  Prerequisite Topic @relation("TopicRequiredBy", fields: [prerequisiteId], references: [id], onDelete: Restrict)

  @@unique([topicId, prerequisiteId])
  @@map("topic_prerequisites")
}

/// 文章：一等实体，独立存在、可被 0..n 个专题引用，**不需要审核**（§6.7、§17.1）
model Article {
  id          String   @id @default(cuid())
  authorId    String
  slug        String   @unique
  title       String
  summary     String   @default("")
  /// 正文的**真源**：Markdown，题目处写 `<Problem baseId={…} />`（§13.3）
  source      String   @default("")
  coverPreset String   @default("slate")
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Author   User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  Topics   TopicArticle[]
  Problems ArticleProblem[]

  @@index([updatedAt])
  @@map("articles")
}

/// 文章 → 题目：从正文解析出来的引用，落库只为「反查文章 / 校验题号」
/// 正文仍然是唯一真源：改正文会整体重算这张表
model ArticleProblem {
  id        String @id @default(cuid())
  articleId String
  /// 题号（base_problems.id）；正文里写的就是它
  baseId    Int
  /// 正文里的出现顺序
  sort      Int    @default(0)

  Article     Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  BaseProblem BaseProblems @relation(fields: [baseId], references: [id], onDelete: Restrict)

  @@unique([articleId, baseId])
  @@index([articleId, sort])
  @@index([baseId])
  @@map("article_problems")
}

/// 课程状态机（§17.3）：draft → pending → published，驳回回 draft
enum CourseStatus {
  DRAFT
  PENDING
  PUBLISHED
}

enum CourseReviewAction {
  SUBMIT
  APPROVE
  REJECT
  WITHDRAW
}

// ============================================================
// 学习进度：访问记录 / 做题记录 / 完成标记
//
// 这三样原本只存在浏览器 localStorage（见 docs/PITFALLS.md P14）：
// 换设备或清缓存就没了，而且无法作数。落库后它们以「用户 + 内容」为键，
// 服务端成为权威，本地只做兜底缓存。
//
// 与内容表的关系：一律 Restrict（内容被删前先想清楚这些记录怎么办），
// 但用户注销时随用户级联清理。
// ============================================================

/// 用户对某个学习内容的**访问**记录（「最近学习」的数据来源）
model LearningVisit {
  id        String          @id @default(cuid())
  userId    String
  /// 访问对象的种类：文章 / 专题 / 课程 / 题目
  kind      LearningKind
  /// 对象主键。文章/专题/课程是 cuid；题目是**题号** baseId（与正文引用一致）
  targetId  String
  /// 最近一次访问时间（同一对象多次访问只更新时间）
  visitedAt DateTime        @default(now())
  createdAt DateTime        @default(now())

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
  @@index([userId, kind, visitedAt])
  @@map("learning_visits")
}

/// **不可逆**的完成标记：达成即写，之后分母怎么变都不回退（设计文档 §17.9）
model LearningCompletion {
  id          String          @id @default(cuid())
  userId      String
  kind        LearningKind
  targetId    String
  completedAt DateTime        @default(now())

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
  @@index([userId, kind])
  @@map("learning_completions")
}

enum LearningKind {
  ARTICLE
  TOPIC
  COURSE
  PROBLEM
}
