# qpc 运行时配置示例。复制为 .env 后按需修改（.env 已被 git 忽略）。
#
# 所有变量都可以被同名命令行参数覆盖（参数 > 环境变量 > 默认值）。

# Web 应用地址，tRPC 挂在 /api/trpc 下
QUANTA_API_URL=http://localhost:3000

# 访问令牌（quanta_access_token）。留空时使用 `qpc login` 保存的凭据。
# 仅适合 CI：注意不要把它写进 shell history。
# QUANTA_TOKEN=

# 凭据目录，默认 $XDG_CONFIG_HOME/quanta 或 ~/.config/quanta
# QUANTA_CONFIG_DIR=

# 单次请求超时（毫秒）
# QUANTA_HTTP_TIMEOUT=15000

# 上传体积上限（字节），超过则拒绝，避免把异常大的产物推给服务端
# QUANTA_MAX_UPLOAD_BYTES=5242880
