{
   "name": "@quantacenter/quanta-problem-cli",
   "version": "1.0.2",
   "description": "Quanta 出题工具链：脚手架、离线预检、上传与发布（qpc）",
   "license": "ISC",
   "repository": {
      "type": "git",
      "url": "git+https://github.com/QuantaCenter/quanta-challenge.git",
      "directory": "packages/problem-creator-cli"
   },
   "publishConfig": {
      "access": "public"
   },
   "type": "module",
   "engines": {
      "node": ">=20.11"
   },
   "bin": {
      "qpc": "./dist/index.js"
   },
   "main": "./dist/program.js",
   "types": "./dist/program.d.ts",
   "exports": {
      ".": {
         "types": "./dist/program.d.ts",
         "import": "./dist/program.js"
      },
      "./package.json": "./package.json"
   },
   "files": [
      "dist",
      "templates",
      "README.md"
   ],
   "scripts": {
      "dev": "tsx src/index.ts",
      "build": "tsup",
      "start": "node dist/index.js",
      "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
      "lint": "biome check .",
      "lint:fix": "biome check --write .",
      "format": "biome format --write .",
      "verify": "pnpm lint && pnpm typecheck && pnpm build"
   },
   "dependencies": {
      "@clack/prompts": "^1.8.1",
      "commander": "^14.0.1",
      "jiti": "^2.5.1",
      "picocolors": "^1.1.1",
      "sharp": "^0.34.3",
      "zod": "^4.0.5"
   },
   "devDependencies": {
      "@biomejs/biome": "^2.5.15",
      "@challenge/shared": "workspace:^",
      "@types/node": "^24.0.14",
      "tsup": "^8.5.1",
      "tsx": "^4.7.1",
      "typescript": "^5.8.3"
   }
}
