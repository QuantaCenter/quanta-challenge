# Database 相关
DATABASE_URL=postgres://username:password@host:5432/quanta_challenge

# JWT 相关
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
ACCESS_TOKEN_EXPIRES_IN=15Mins
REFRESH_TOKEN_EXPIRES_IN=7Days

# Redis 相关
REDIS_HOST=your_redis_host_here
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# Server 相关
JUDGE_SERVER=http://your_judge_server_host:1888
APP_SERVER=http://your_app_server_host:3000
API_BASE_URL=http://your_api_base_url:3000

# 本地存储路径
LOCAL_STORE_PATH=./local_store

# Rank 相关
PROBLEM_RANKING_CACHE_TTL=3600
GLOBAL_RANKING_CACHE_TTL=3600

# Achievement 相关
ACHIEVEMENT_OBSERVER_MAX_CACHE_SIZE=3000

# 文件系统同步配置（代码读取的是 FILE_SYNC_MAX_CHANGES）
FILE_SYNC_MAX_CHANGES=50

# 成就观察器缓存上限
ACHIEVEMENT_OBSERVER_MAX_CACHE_SIZE=3000

# 临时文件目录（判题快照解压等场景使用）
TEMP_DIR=./tmp

# Webhook 相关
OPENAPI_WEBHOOK_SECRET=your_openapi_webhook_secret_here

# 邮件相关
EMAIL_ACCOUNT=your_email_account_here
EMAIL_SMTP_PASSWORD=your_email_smtp_password_here

# 定时器 Worker（代码读取的是 TIMER_POLL_INTERVAL_MS / TIMER_BATCH_SIZE / TIMER_RETRY_BACKOFF_MS / TIMER_MAX_RETRY_BACKOFF_MS）
TIMER_POLL_INTERVAL_MS=5000
TIMER_BATCH_SIZE=20
TIMER_RETRY_BACKOFF_MS=30000
TIMER_MAX_RETRY_BACKOFF_MS=300000

# 密码哈希
PASSWORD_SALT_ROUNDS=10

# thumbhash 缓存
THUMBHASH_REDIS_CACHE_TTL_SECONDS=2592000
THUMBHASH_MEMORY_CACHE_SIZE=1000

# 用户活跃时间写库节流
TRACK_ACTIVE_WRITE_INTERVAL_MS=300000

# WebAuthn
WEB_AUTHN_OPTIONS_TTL_SECONDS=300

# 每日一题 / 签到业务时区
DAILY_TIMEZONE=Asia/Shanghai

# 云函数调用令牌 TTL（前后端共用）
CLOUD_FUNCTION_TOKEN_TTL_SECONDS=7200

# 快照镜像体积上限（前后端与 routeRules 同源）
IMAGE_BUILD_MAX_COMPRESSED_BYTES=167772160
IMAGE_BUILD_MAX_RAW_BYTES=1073741824

# Quanta OIDC. Keep disabled until provider/backend and database migrations are ready.
# Secrets are read ONLY on the Nitro server, never Nuxt public runtimeConfig.
# 前端 issuer 白名单共用 QUANTA_OAUTH_ISSUER；如需单独覆盖，设置 NUXT_PUBLIC_QUANTA_OAUTH_ISSUER。
QUANTA_OAUTH_ENABLED=false
QUANTA_OAUTH_ISSUER=https://www.example.com
QUANTA_OAUTH_APP_ORIGIN=https://challenge.example.com
QUANTA_OAUTH_CLIENT_ID=quanta-challenge
QUANTA_OAUTH_CLIENT_SECRET=

# Server-only AI judge quality gate (Responses API).
# Never set this key in NUXT_PUBLIC_* or commit a real key.
NUXT_LLM_API_KEY=
NUXT_LLM_RESPONSES_URL=https://api.deepseek.com/responses
NUXT_LLM_MODEL=deepseek-flash
NUXT_TIMER_QUALITY_CONCURRENCY=3
NUXT_TIMER_CONCURRENCY=3
# GitHub App：仅服务端使用。回调为 <ORIGIN>/api/auth/github/callback。
# 安装 Setup URL 为 <ORIGIN>/api/auth/github/setup；Webhook 为 <ORIGIN>/api/webhooks/github。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub App 页面 https://github.com/apps/<slug> 的最后一段。
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=
# 在 Challenge 的 .env 中配置，不在 GitHub App 后台配置。
# 生成：openssl rand -base64 32。部署后保持稳定，遗失后需要重新授权。
GITHUB_TOKEN_KEY=
GITHUB_ORIGIN=http://localhost:3001
# 公开仓库归档镜像，按顺序尝试；空数组直接访问 GitHub，最后始终回退 GitHub 原源。
# 支持 {url} 或 {owner}/{repo}/{sha} 模板。
GITHUB_ARCHIVE_MIRRORS='["https://ghfast.top/{url}","https://gh.monlor.com/{url}"]'
GITHUB_ARCHIVE_TIMEOUT_MS=300000
NUXT_TIMER_GITHUB_IMPORT_CONCURRENCY=2
# 亦支持 Nuxt 原生 NUXT_GITHUB_*，对应 runtimeConfig.github 的字段，优先于 GITHUB_*。
