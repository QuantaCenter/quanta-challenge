{
   "name": "@challenge/app",
   "private": true,
   "type": "module",
   "scripts": {
      "build": "node scripts/pre-build.ts && nuxt build && node scripts/post-build.ts",
      "build:large": "node scripts/pre-build.ts && node --max-old-space-size=6144 ./node_modules/nuxt/bin/nuxt.mjs build && node scripts/post-build.ts",
      "dev": "nuxt dev --host",
      "dev:watch": "node scripts/dev-watchdog.mjs",
      "generate": "nuxt generate",
      "preview": "nuxt preview",
      "prod": "node .output/server/index.mjs",
      "test": "vitest",
      "smoke": "node scripts/smoke-test.mjs",
      "typecheck": "nuxt prepare && tsc --noEmit -p tsconfig.typecheck.server.json && vue-tsc --noEmit -p tsconfig.typecheck.app.json",
      "typecheck:server": "nuxt prepare && tsc --noEmit -p tsconfig.typecheck.server.json",
      "typecheck:app": "nuxt prepare && vue-tsc --noEmit -p tsconfig.typecheck.app.json",
      "postinstall": "nuxt prepare",
      "prisma:migrate:dev": "pnpm --filter @challenge/database prisma:migrate",
      "prisma:migrate:deploy": "pnpm --filter @challenge/database prisma:migrate:deploy",
      "prisma:generate": "pnpm --filter @challenge/database prisma:generate",
      "prisma:update": "pnpm --filter @challenge/database prisma:update",
      "docker:build": "docker build -t challenge-web-app -f ./Dockerfile ../.."
   },
   "dependencies": {
      "@challenge/database": "workspace:^",
      "@challenge/judge-machine-agent": "workspace:^",
      "@challenge/shared": "workspace:^",
      "@highlightjs/vue-plugin": "^2.1.0",
      "@icon-park/vue-next": "^1.4.2",
      "@pinia/nuxt": "^0.11.1",
      "@popperjs/core": "^2.11.8",
      "@prisma/client": "^6.12.0",
      "@simonwep/pickr": "^1.9.1",
      "@simplewebauthn/browser": "^13.1.2",
      "@simplewebauthn/server": "^13.1.2",
      "@trpc/client": "^11.4.3",
      "@trpc/server": "^11.4.3",
      "@types/bcrypt": "^5.0.2",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/lodash": "^4.17.20",
      "@types/mime-types": "^3.0.1",
      "@volar/jsdelivr": "^2.4.23",
      "@volar/monaco": "^2.4.23",
      "@vue/language-service": "^2.2.0",
      "@webcontainer/api": "^1.6.1",
      "bcrypt": "^6.0.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "color": "^5.0.0",
      "dayjs": "^1.11.13",
      "es-module-lexer": "^1.7.0",
      "highlight.js": "^11.11.1",
      "ioredis": "^5.6.1",
      "jsonwebtoken": "^9.0.2",
      "lodash": "^4.17.21",
      "lodash-es": "^4.17.21",
      "lucide-vue-next": "^0.525.0",
      "marked": "^16.1.1",
      "mime-types": "^3.0.1",
      "minimatch": "^10.1.1",
      "monaco-editor": "^0.52.2",
      "node-sql-parser": "^5.3.12",
      "nodemailer": "^8.0.1",
      "nuxt": "^4.0.0",
      "nuxt-security": "^2.3.0",
      "path-browserify": "^1.0.1",
      "pinia": "^3.0.3",
      "pino": "^10.3.1",
      "pino-pretty": "^13.1.3",
      "prisma": "^6.12.0",
      "reka-ui": "^2.3.2",
      "tailwind-merge": "^3.3.1",
      "trpc-nuxt": "^1.2.0",
      "tw-animate-css": "^1.3.5",
      "vm2": "^3.9.19",
      "vscode-uri": "^3.1.0",
      "vue": "^3.5.17",
      "vue-router": "^4.5.1",
      "xterm": "^5.3.0",
      "xterm-addon-fit": "^0.8.0",
      "zod": "^4.0.5"
   },
   "devDependencies": {
      "@shikijs/monaco": "^3.9.2",
      "@tailwindcss/vite": "^4.1.11",
      "@types/nodemailer": "^7.0.11",
      "@vueuse/core": "^13.6.0",
      "@vueuse/nuxt": "^13.6.0",
      "shiki": "^3.8.1",
      "tailwindcss": "^4.1.11",
      "typescript": "^5.8.3",
      "vitest": "^3.2.4",
      "vue-tsc": "^3.3.12"
   }
}
