{
   "name": "@challenge/backend-judge-machine-agent",
   "type": "module",
   "exports": {
      "./schemas": "./src/schemas/index.ts"
   },
   "scripts": {
      "dev": "vite",
      "build": "vite build",
      "start": "node dist/index.js",
