      "vm2": "^3.9.19",
      "zod": "^4.0.5"
   },
   "devDependencies": {
      "@hono/vite-build": "^1.8.0",
      "@hono/vite-dev-server": "^0.24.0",
      "@types/node": "^24.0.14",
      "tsx": "^4.7.1",
      "typescript": "^5.8.3",
      "vite": "^7.3.0"
   }
}
