{
   "compilerOptions": {
      "target": "ESNext",
      "strict": true,
      "verbatimModuleSyntax": true,
      "skipLibCheck": true,
      "types": ["node"],
      "jsx": "react-jsx",
      "jsxImportSource": "hono/jsx",
      "outDir": "./dist",
      "moduleResolution": "Bundler",
      "module": "ESNext",
      "allowImportingTsExtensions": true,
      "noEmit": true
   },
   "exclude": ["node_modules", "test"]
}
