# 复制为 .env 后修改（同目录下：cp .env.example .env）

# Grafana 管理员账号
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

# Grafana 对外访问地址（反代后请改为 https://obs.example.com）
GRAFANA_ROOT_URL=http://127.0.0.1:13000

# observation 服务管理接口（配置/告警记录 CRUD）鉴权 Token，必填
OBS_API_TOKEN=change-me-random-token

# 前端 SDK 上报接口 Token（可留空；公网部署建议设置并写入 SDK 初始化参数）
OBS_REPORT_TOKEN=

# 业务栈 compose 网络（Prometheus/observation 加入其中抓取业务后端 /metrics）
# 默认即 quanta-challenge 项目生成的网络名
APP_NETWORK=quanta-challenge_quanta-challenge-network

# 统一查数 MCP（仅绑定 127.0.0.1:9320）
# 在 Grafana 中创建 Viewer Service Account，并授予目标 Prometheus/Loki datasource 查询权限。
GRAFANA_MCP_SERVICE_ACCOUNT_TOKEN=glsa_change-me
# 一个或多个 caller:token，以逗号分隔；caller 会写入审计日志。
DATA_MCP_BEARER_TOKENS=cursor:change-me-random-mcp-token
# 需先执行 packages/challenge-data-mcp/sql/provision-reader.sql 创建该只读账号和安全视图。
# 密码含 URL 保留字符时必须 URL 编码。
DATA_MCP_DATABASE_URL=postgresql://data_agent_reader:change-me-reader-password@postgres:5432/quanta_db
DATA_MCP_PUBLIC_URL=http://127.0.0.1:9320/mcp
DATA_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,data-mcp
DATA_MCP_ALLOWED_ORIGINS=localhost,127.0.0.1
DATA_MCP_MAX_LOOKBACK_HOURS=720
