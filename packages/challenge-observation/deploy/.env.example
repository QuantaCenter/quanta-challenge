# 复制为 .env 后修改（同目录下：cp .env.example .env）

# Grafana 管理员账号
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-password

# Grafana 对外访问地址（反代后请改为 https://obs.example.com）
GRAFANA_ROOT_URL=http://127.0.0.1:13000

# observation 服务管理接口（配置/告警记录 CRUD）鉴权 Token，必填
OBS_API_TOKEN=change-me-random-token

# 前端 SDK 上报接口 Token（可留空；公网部署建议设置并写入 SDK 初始化参数）
OBS_REPORT_TOKEN=

# 业务栈 compose 网络（Prometheus/observation 加入其中抓取业务后端 /metrics）
# 默认即 quanta-challenge 项目生成的网络名
APP_NETWORK=quanta-challenge_quanta-challenge-network
