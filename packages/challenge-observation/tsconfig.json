{
   "compilerOptions": {
      "target": "ES2022",
      "lib": ["ES2022", "DOM", "DOM.Iterable"],
      "module": "ESNext",
      "moduleResolution": "bundler",
      "allowImportingTsExtensions": true,
      "types": ["node"],
      "strict": true,
      "skipLibCheck": true,
      "noEmit": true
   },
   "include": ["src"]
}
