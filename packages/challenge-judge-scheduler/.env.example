# 评测调度器环境变量
# 与 docker/docker-compose.development.yaml 暴露的端口保持一致：
# PostgreSQL -> 25432，Redis -> 26379

DATABASE_URL=postgresql://quanta:quanta@localhost:25432/quanta_db?schema=public

# Redis（BullMQ 队列）
REDIS_HOST=localhost
REDIS_PORT=26379
REDIS_PASSWORD=

# 服务监听端口（宿主机本地开发使用 1888）
PORT=1888

# 判题完成后回调 Web 应用的地址，用于同步排行榜与发送通知
APP_SERVER_URL=http://localhost:3000

# 仅在使用 `pnpm start`（运行构建产物）时需要设为 production；
# `pnpm dev` 由 vite dev server 提供，且会覆盖此项。
NODE_ENV=production

# 前端（Playwright）判题机镜像缺失时的行为。
# 缺镜像本就会自动降级为警告（只跑后端服务题型的环境不需要那个体积很大的镜像），
# 这个开关用于「镜像在、但 1889 端口被占 / 容器起不来」时也强行降级为警告。
# 降级后前端题型提交会以 "Judge machine WebSocket is not connected" 失败，
# 后端服务题型不受影响，/health 会返回 status=degraded。
# JUDGE_MACHINE_OPTIONAL=1

# 共享 pnpm 缓存目录。**必须留空或填宿主机绝对路径**。
# 留空时自动选择：容器内 /app/pnpm-cache，本地开发 <仓库根>/.pnpm-cache。
# 别把容器里的 /app/pnpm-cache 写进本地 .env —— 宿主机上根目录不可写，
# 启动会以 ENOENT: mkdir '/app' 直接失败。详见 docs/PNPM_CACHE.md。
# PNPM_CACHE_DIR=
