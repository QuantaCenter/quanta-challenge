{
   "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "bundler",
      "strict": true,
      "skipLibCheck": true,
      "noEmit": true,
      "allowImportingTsExtensions": true,
      "esModuleInterop": true,
      "types": ["node"]
   },
   "include": ["playwright.config.ts", "helpers/**/*.ts", "seed/**/*.ts", "tests/**/*.ts"]
}
